<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.example.baseplate</groupId>
  <artifactId>baseplate-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>baseplate-parent</name>

  <properties>
    <java.version>21</java.version>
    <baseplate-api.version>1.0.0-SNAPSHOT</baseplate-api.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>baseplate-api</module>
    <module>baseplate-domain</module>
    <module>baseplate-application</module>
    <module>baseplate-runtime</module>
    <module>baseplate-registry</module>
    <module>baseplate-starter</module>
    <module>baseplate-contract</module>
    <module>baseplate-adapters</module>
    <module>baseplate-identity-starter</module>
    <module>baseplate-workflow-starter</module>
    <module>baseplate-rule-starter</module>
    <module>baseplate-security-starter</module>
    <module>baseplate-audit-starter</module>
    <module>baseplate-platform-starter</module>
    <module>baseplate-metadata-starter</module>
    <module>baseplate-agent-starter</module>
    <module>baseplate-agent-workflow-starter</module>
    <module>baseplate-dataagent-starter</module>
    <module>baseplate-cend-starter</module>
    <module>baseplate-bootstrap</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.example.baseplate</groupId>
        <artifactId>baseplate-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.baseplate</groupId>
        <artifactId>baseplate-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.baseplate</groupId>
        <artifactId>baseplate-application</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
